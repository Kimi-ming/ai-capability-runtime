{
  "name": "secret-like provider fields are redacted",
  "input": {
    "token": "provider-token",
    "nested": {
      "authorization": "Bearer abc.def"
    }
  },
  "expectedValue": {
    "token": "[REDACTED]",
    "nested": {
      "authorization": "[REDACTED]"
    }
  },
  "expectedFindings": [
    {
      "code": "SECRET_REDACTED",
      "path": "/token"
    },
    {
      "code": "SECRET_REDACTED",
      "path": "/nested/authorization"
    }
  ],
  "notContains": [
    "provider-token",
    "Bearer abc.def"
  ]
}
