{
  "name": "@opencap/spec",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "OpenCap Capability Manifest schema and validation tools.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
