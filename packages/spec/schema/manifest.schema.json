{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencap.dev/schema/manifest.schema.json",
  "title": "OpenCap Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "version",
    "type",
    "input",
    "output",
    "auth",
    "permissions",
    "execution",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "Stable registry identifier such as github.create_issue."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "type": {
      "type": "string",
      "enum": [
        "http"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "since"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "deprecated",
            "yanked",
            "revoked"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "advisory": {
          "type": "string",
          "pattern": "^OCAP-[0-9]{4}-[0-9]{4,}$"
        },
        "replacement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "revoked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "advisory"
            ]
          }
        }
      ]
    },
    "input": {
      "$ref": "#/$defs/jsonSchema"
    },
    "output": {
      "$ref": "#/$defs/jsonSchema"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "api_key",
            "oauth2"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bearer",
                "header"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^(?!(?:[Aa]uthorization|[Cc]ookie|[Ss]et-[Cc]ookie)$)[A-Za-z][A-Za-z0-9-]*$"
            },
            "prefix": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "api_key"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "provider",
              "env",
              "placement",
              "scopes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "none"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["provider"] },
                { "required": ["env"] },
                { "required": ["placement"] },
                { "required": ["scopes"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "placement": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "header"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "placement"
            ]
          },
          "then": {
            "properties": {
              "placement": {
                "required": [
                  "name"
                ]
              }
            }
          }
        }
      ]
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "action",
          "risk",
          "confirmation"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "enum": [
              "read_only",
              "write",
              "external_send",
              "destructive",
              "financial",
              "code_execution",
              "secret_access"
            ]
          },
          "confirmation": {
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "method",
        "url",
        "timeout_ms"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "fields"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json"
              ]
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/jsonValue"
              }
            }
          }
        },
        "reconcile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "hint",
            "retry_guidance",
            "policy_effect"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "manual",
                "provider_lookup"
              ]
            },
            "hint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "provider_request_id_field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
            },
            "resource_ref_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              }
            },
            "retry_guidance": {
              "type": "string",
              "const": "do_not_retry_until_reconciled"
            },
            "policy_effect": {
              "type": "string",
              "const": "none"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyEffect"
      ],
      "properties": {
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "git",
                "local",
                "future_oci",
                "future_slsa"
              ]
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,64}$"
            },
            "digest": {
              "$ref": "#/$defs/sha256Digest"
            },
            "buildType": {
              "type": "string",
              "enum": [
                "manual_review",
                "future_slsa",
                "future_sigstore",
                "future_oci"
              ]
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publisher": {
              "type": "string",
              "enum": [
                "manual",
                "npm_trusted_publishing",
                "future_sigstore",
                "future_org_signature"
              ]
            },
            "provenance": {
              "type": "string",
              "enum": [
                "none",
                "npm",
                "future_slsa",
                "future_sigstore"
              ]
            },
            "workflowRef": {
              "type": "string",
              "minLength": 1
            },
            "attestationDigest": {
              "$ref": "#/$defs/sha256Digest"
            },
            "transparencyLogRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "policyEffect": {
          "type": "string",
          "const": "none"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "maintainer",
        "license",
        "trust_level"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "maintainer": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "trust_level": {
          "type": "string",
          "enum": [
            "experimental",
            "listed",
            "tested",
            "verified",
            "official"
          ]
        },
        "homepage": {
          "type": "string"
        },
        "network_access": {
          "type": "string",
          "enum": [
            "fixed_url",
            "arbitrary_url"
          ]
        },
        "unsafe_by_default": {
          "type": "boolean"
        },
        "risk_notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "jsonSchema": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object"
        }
      }
    }
  }
}
