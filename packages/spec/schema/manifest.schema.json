{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencap.dev/schema/manifest.schema.json",
  "title": "OpenCap Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "version",
    "type",
    "input",
    "output",
    "auth",
    "permissions",
    "execution",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "Stable registry identifier such as github.create_issue."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "type": {
      "type": "string",
      "enum": ["http", "mcp", "local"]
    },
    "input": {
      "$ref": "#/$defs/jsonSchema"
    },
    "output": {
      "$ref": "#/$defs/jsonSchema"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "api_key", "oauth2"]
        },
        "provider": {
          "type": "string"
        },
        "env": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "action", "risk", "confirmation"],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "enum": [
              "read_only",
              "write",
              "external_send",
              "destructive",
              "financial",
              "code_execution",
              "secret_access"
            ]
          },
          "confirmation": {
            "type": "string",
            "enum": ["allow", "ask", "deny"]
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method", "url", "timeout_ms"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "maintainer", "license", "trust_level"],
      "properties": {
        "category": {
          "type": "string"
        },
        "maintainer": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "trust_level": {
          "type": "string",
          "enum": ["experimental", "listed", "tested", "verified", "official"]
        },
        "homepage": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "jsonSchema": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object"
        }
      }
    }
  }
}
