{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencap.dev/schema/capability-advisory.schema.json",
  "title": "OpenCap Capability Advisory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "capability",
    "affected_versions",
    "type",
    "severity",
    "status",
    "summary",
    "published_at",
    "modified_at",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "opencap.capability_advisory.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^OCAP-[0-9]{4}-[0-9]{4}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "affected_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "type": {
      "type": "string",
      "enum": [
        "malicious",
        "overbroad_permissions",
        "credential_leak",
        "unsafe_execution",
        "misleading_metadata",
        "provider_changed",
        "maintainer_compromise"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "triaged",
        "investigating",
        "fixed",
        "mitigated",
        "revoked",
        "not_affected",
        "published"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "modified_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "runtime_default",
        "fixed_version"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "enum": [
            "none",
            "freeze",
            "yank",
            "revoke"
          ]
        },
        "runtime_default": {
          "type": "string",
          "enum": [
            "warn",
            "ask",
            "deny"
          ]
        },
        "fixed_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
