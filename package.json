{
  "name": "opencap-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCap is an open-source capability layer for AI-native applications.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "validate": "pnpm --filter @opencap/spec validate",
    "dev:cli": "pnpm --filter @opencap/cli dev",
    "serve:mcp": "pnpm --filter @opencap/cli dev -- serve --mcp"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
